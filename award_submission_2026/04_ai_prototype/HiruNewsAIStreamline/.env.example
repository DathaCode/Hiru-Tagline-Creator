# HiruNews AI Streamline — Phase 2 Prototype
# Copy this file to .env and fill in your API keys

# OpenAI API key (optional — runs in MOCK mode without it)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Set to "true" to force demo mode with mock data (no real API calls)
DEMO_MODE=true

# Handoff output path — where ai_handoff.json is exported for HiruTaglineCreator
# Leave blank to use the default (data/sessions/ folder alongside this app)
HANDOFF_OUTPUT_PATH=
