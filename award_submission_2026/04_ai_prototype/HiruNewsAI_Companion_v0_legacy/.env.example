# HiruNews AI Streamline — Phase 2 Prototype
# Copy this file to .env and fill in your API keys

# OpenAI API key (required for transcription and tagline generation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Gemini API key (optional — future integration)
GEMINI_API_KEY=your-gemini-api-key-here

# Handoff output path — where ai_handoff.json is exported for HiruTaglineCreator
# Leave blank to use the default (sessions/ folder alongside this app)
HANDOFF_OUTPUT_PATH=

# Set to "true" to run in demo mode with mock data (no real API calls made)
DEMO_MODE=false
